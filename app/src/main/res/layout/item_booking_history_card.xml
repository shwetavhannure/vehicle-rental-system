<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="16dp">

    <androidx.cardview.widget.CardView
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        app:cardBackgroundColor="#052E47"
        app:cardCornerRadius="16dp"
        android:elevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <ImageView android:id="@+id/ivBookingVehicle" android:layout_width="100dp" android:layout_height="60dp" android:scaleType="fitCenter" />
                <TextView android:id="@+id/tvBookingVehicleName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/ivBookingVehicle" android:layout_marginStart="16dp" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvBookingIDValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/ivBookingVehicle" android:layout_below="@id/tvBookingVehicleName" android:layout_marginStart="16dp" android:textColor="#B0BEC5" android:textSize="14sp" />
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#264653" android:layout_marginVertical="12dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/tvBookingStartDateTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvStartCity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#B0BEC5" android:textSize="12sp" android:layout_marginTop="2dp" />
                    <TextView android:id="@+id/tvBookingEndDateTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="8dp" />
                    <TextView android:id="@+id/tvEndCity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#B0BEC5" android:textSize="12sp" android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="110dp"
                    android:layout_height="85dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/booking_fare_bg"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total Fare" android:textColor="#2E7D32" android:textSize="10sp" android:gravity="center"/>
                    <TextView android:id="@+id/tvTotalFare" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#1B5E20" android:textStyle="bold" android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#264653" android:layout_marginVertical="12dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2">
                <LinearLayout android:id="@+id/llViewLocation" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" app:srcCompat="@drawable/ic_location_on" android:tint="#00BCD4"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="View Location" android:textColor="#FFFFFF" android:textSize="12sp" android:maxLines="1" android:layout_marginTop="2dp"/>
                </LinearLayout>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#264653" />
                <LinearLayout android:id="@+id/llCancelBooking" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" app:srcCompat="@drawable/ic_cancel" android:tint="#F44336"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cancel Booking" android:textColor="#FFFFFF" android:textSize="12sp" android:maxLines="1" android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>